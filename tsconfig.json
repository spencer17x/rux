{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "electron", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["electron.vite.config.ts", "src/electron/**/*.ts", "src/shared/**/*.ts", "src/renderer/**/*.ts", "src/**/*.tsx"]
}
